# ─── Database ────────────────────────────────────────────────────────────────
# Uncomment ONE of the options below depending on where you're running.

# Option A — Replit managed PostgreSQL (auto-injected; no entry needed here)
# DATABASE_URL=  # leave blank; Replit sets this automatically

# Option B — External / Neon PostgreSQL
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Option C — Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/braingames?sslmode=disable

DATABASE_URL=postgresql://postgres:password@localhost:5432/braingames?sslmode=disable

# ─── Session ─────────────────────────────────────────────────────────────────
# Use a long random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_use_a_long_random_string

# ─── Server port ─────────────────────────────────────────────────────────────
# The workflow sets PORT=8080. Change here only for local dev.
# PORT=8080

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Without these, the app runs in guest-only mode.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:8080/api/callback/google

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Set to true to skip the automatic `drizzle-kit push` on server startup.
# Useful when running locally without a DB available yet.
# SKIP_DB_PUSH=true
